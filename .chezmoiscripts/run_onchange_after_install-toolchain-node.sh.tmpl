#!/usr/bin/env bash

{{ range .toolchains -}}
{{- if eq .name "node" -}}
{{- $toolchain := . }}
mise use --global --yes {{ $toolchain.name }}@{{ $toolchain.version }}
{{ range $toolchain.packages -}}
mise exec {{ $toolchain.name }} -- {{ .install_command }} {{ .name }}
{{ end -}}
{{- end }}
{{ end -}}
